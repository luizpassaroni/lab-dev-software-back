# Conexão com o banco de dados PostgreSQL
DATABASE_URL=postgresql://user:pass@localhost:5432/guia_streaming

# Segredo para assinar os tokens JWT (gere com: openssl rand -base64 32)
JWT_SECRET=trocar-em-producao-use-openssl-rand-base64-32

# Token de autenticação da API do TMDB (obtenha em: https://developer.themoviedb.org/reference/intro/authentication)
TMDB_API_TOKEN=ver-https://developer.themoviedb.org/reference/intro/authentication

# Chave interna compartilhada entre o Back e o BFF Next.js (mínimo 16 caracteres)
INTERNAL_API_KEY=trocar-em-producao-secret-compartilhado-com-o-next

# Ambiente de execução (development | production)
NODE_ENV=development

# Porta do servidor (padrão: 3000)
PORT=3001