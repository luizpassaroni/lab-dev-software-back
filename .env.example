# Database
DATABASE_URL="postgresql://local_user:local_password_123@postgres_local:5432/uva_local_db"

# JWT Configuration
# Generate a secure secret: openssl rand -base64 32
JWT_SECRET=trocar-em-producao

# TMDB API
# v4 Read Access Token (Bearer) — https://www.themoviedb.org/settings/api
TMDB_API_TOKEN=

# Internal API Key
# Shared secret with the Next BFF — same value on both sides
# Generate a secure secret: openssl rand -base64 32
INTERNAL_API_KEY=trocar-em-producao

# Runtime environment
NODE_ENV=development

# Swagger UI (available at /api/docs outside production)
SWAGGER_ENABLED=true

# Server port (defaults to 3000 if unset)
PORT=3000
