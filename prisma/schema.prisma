generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TmdbType {
  MOVIE
  TV
}

enum WatchedOrigin {
  manual
  auto
}

model User {
  id           Int        @id @default(autoincrement())
  name         String
  email        String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  ratings      Rating[]
  watched      Watched[]
  favorites    Favorite[]
}

model Rating {
  id        Int      @id @default(autoincrement())
  userId    Int
  tmdbId    Int
  tmdbType  TmdbType
  score     Float
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, tmdbId, tmdbType])
}

model Watched {
  id        Int           @id @default(autoincrement())
  userId    Int
  tmdbId    Int
  tmdbType  TmdbType
  origem    WatchedOrigin
  watchedAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id])

  @@unique([userId, tmdbId, tmdbType])
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  tmdbId    Int
  tmdbType  TmdbType
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, tmdbId, tmdbType])
}
