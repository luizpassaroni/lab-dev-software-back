generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int        @id @default(autoincrement())
  name         String
  email        String     @unique
  passwordHash String
  createdAt    DateTime   @default(now())
  ratings      Rating[]
  watched      Watched[]
  favorites    Favorite[]
}

model Rating {
  id        Int      @id @default(autoincrement())
  userId    Int
  tmdbId    Int
  tmdbType  String
  score     Float
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, tmdbId, tmdbType])
}

model Watched {
  id         Int      @id @default(autoincrement())
  userId     Int
  tmdbId     Int
  tmdbType   String
  watchedAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@unique([userId, tmdbId, tmdbType])
}

model Favorite {
  id        Int      @id @default(autoincrement())
  userId    Int
  tmdbId    Int
  tmdbType  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, tmdbId, tmdbType])
}